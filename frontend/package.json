{
  "name": "troot-window",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "cap:sync": "npm run build && (test -d android || npx cap add android) && npm run icons && npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:build": "npm run cap:sync && npx cap build android",
    "test:contract": "node scripts/verify-api-contract.mjs",
    "test:categories": "node scripts/verify-categories.mjs",
    "verify:sources": "node scripts/verify-sources.mjs",
    "sync:jobs": "node scripts/ingest-jobs.mjs",
    "sync:jobs:dry": "node scripts/ingest-jobs.mjs --dry-run",
    "icons": "node scripts/build-icons.mjs && npx capacitor-assets generate --android",
    "test:logos": "node scripts/verify-company-logos.mjs",
    "test:workers": "node scripts/test-workers.mjs",
    "test:workers:e2e": "node scripts/e2e-workers.mjs",
    "test:security": "node scripts/verify-security.mjs",
    "icons:web": "node scripts/build-favicons.mjs",
    "test:favicon": "node scripts/verify-favicon.mjs",
    "test:location": "node scripts/test-worker-location.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@supabase/supabase-js": "^2.58.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.64.1",
    "sharp": "^0.34.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
